<?xml version="1.0" encoding="UTF-8"?>
<!-- An XSD 1.1 schema for a manuscript catalogue. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="catalogue">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="manuscript" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="shelfmark" type="xs:string"/>
              <xs:element name="leaves" type="xs:positiveInteger"/>
            </xs:sequence>
            <xs:attribute name="id" type="xs:ID" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
