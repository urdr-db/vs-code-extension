{
  "name": "urdr-xml",
  "displayName": "Urðr-XML",
  "description": "Checks TEI and other XML against RELAX NG, XSD, Schematron and DTD, checks XSLT, XQuery and XPath, suggests what the schema allows, runs and previews XSLT, and reads TEI ODD files as schemas, with Urðr's own engine. No server, no Java.",
  "version": "0.5.0",
  "publisher": "urdr-db",
  "icon": "media/icon.png",
  "galleryBanner": { "color": "#1e1e1e", "theme": "dark" },
  "license": "MPL-2.0",
  "repository": { "type": "git", "url": "https://github.com/urdr-db/vs-code-extension" },
  "engines": { "vscode": "^1.95.0" },
  "categories": ["Programming Languages", "Linters"],
  "keywords": ["TEI", "XML", "RELAX NG", "Schematron", "XSD", "XSLT", "XQuery", "XPath", "digital humanities"],
  "main": "./out/client.js",
  "browser": "./out/web/client.js",
  "activationEvents": ["onLanguage:xml", "onLanguage:xsl", "onLanguage:xquery"],
  "contributes": {
    "languages": [
      {
        "id": "xquery",
        "aliases": ["XQuery", "xquery"],
        "extensions": [".xq", ".xql", ".xqm", ".xqy", ".xquery"],
        "configuration": "./syntaxes/xquery.language-configuration.json"
      },
      {
        "id": "xml",
        "extensions": [".tei", ".odd", ".rng", ".sch"]
      }
    ],
    "grammars": [
      { "language": "xquery", "scopeName": "source.xquery", "path": "./syntaxes/xquery.tmLanguage.json" }
    ],
    "configuration": {
      "title": "Urðr-XML",
      "properties": {
        "urdr.validation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Check XML documents against the schemas they name (xml-model, xsi:schemaLocation, DOCTYPE)."
        },
        "urdr.validation.fetchRemoteSchemas": {
          "type": "boolean",
          "default": true,
          "description": "Download schemas that documents name by http(s) address, such as the TEI schemas on tei-c.org. Downloads are kept, so each is read once."
        },
        "urdr.checkDelay": {
          "type": "number",
          "default": 400,
          "minimum": 0,
          "description": "Milliseconds to wait after typing stops before checking."
        },
        "urdr.transforms": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "markdownDescription": "Saved XSLT transforms, for **Transform with XSLT…** and the preview. Paths are relative to the workspace folder. `output` may use `${fileBasenameNoExtension}`, `${fileDirname}` and `${workspaceFolder}`.",
          "items": {
            "type": "object",
            "required": ["stylesheet"],
            "properties": {
              "name": { "type": "string", "description": "Shown when choosing a transform." },
              "stylesheet": { "type": "string", "description": "The stylesheet, such as xslt/tei-to-html.xsl." },
              "source": {
                "type": "string",
                "description": "The documents it applies to, as a glob such as tei/**/*.xml. Leave out for a stylesheet that runs without a source."
              },
              "output": {
                "type": "string",
                "description": "Where to write the result, such as html/${fileBasenameNoExtension}.html. Without it the result opens in a new editor."
              },
              "parameters": {
                "type": "object",
                "additionalProperties": { "type": "string" },
                "description": "Stylesheet parameters by name (local or Q{uri}local)."
              },
              "initialTemplate": { "type": "string", "description": "The named template to start at." },
              "initialMode": { "type": "string", "description": "The mode to apply templates in." }
            }
          }
        },
        "urdr.odd.source": {
          "type": "string",
          "default": "",
          "markdownDescription": "The TEI source that ODD files compile against (`p5subset.xml`), as a path or URL. Empty uses the one that ships with the extension (TEI P5 4.12.0)."
        },
        "urdr.oxygenShortcuts": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Give the element actions Oxygen XML Editor's keys in XML editors: Surround with Tags (`Ctrl+E`), Surround with the Last Tag (`Ctrl+/`), Delete Element Tags (`Alt+Shift+X`), Split Element (`Alt+Shift+D`), Join Elements (`Alt+Shift+J`). They replace VS Code's own uses of these keys there. Off, the actions are still in the Command Palette."
        },
        "urdr.transform.timeout": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "description": "Seconds a transformation may run before it is stopped."
        }
      }
    },
    "commands": [
      {
        "command": "urdr.surroundWithTags",
        "title": "Surround with Tags…",
        "category": "Urðr-XML"
      },
      {
        "command": "urdr.surroundWithLastTag",
        "title": "Surround with the Last Tag",
        "category": "Urðr-XML"
      },
      {
        "command": "urdr.deleteElementTags",
        "title": "Delete Element Tags",
        "category": "Urðr-XML"
      },
      {
        "command": "urdr.splitElement",
        "title": "Split Element",
        "category": "Urðr-XML"
      },
      {
        "command": "urdr.joinElements",
        "title": "Join Elements",
        "category": "Urðr-XML"
      },
      {
        "command": "urdr.renameElement",
        "title": "Rename Element",
        "category": "Urðr-XML"
      },
      {
        "command": "urdr.transform",
        "title": "Transform with XSLT…",
        "category": "Urðr-XML",
        "icon": "$(run)"
      },
      {
        "command": "urdr.compileOdd",
        "title": "Compile ODD to RELAX NG",
        "category": "Urðr-XML"
      },
      {
        "command": "urdr.preview",
        "title": "Open XSLT Preview to the Side",
        "category": "Urðr-XML",
        "icon": "$(open-preview)"
      }
    ],
    "keybindings": [
      { "command": "urdr.surroundWithTags", "key": "ctrl+e", "mac": "cmd+e", "when": "editorTextFocus && !editorReadonly && (editorLangId == xml || editorLangId == xsl) && config.urdr.oxygenShortcuts" },
      { "command": "urdr.surroundWithLastTag", "key": "ctrl+/", "mac": "cmd+/", "when": "editorTextFocus && !editorReadonly && (editorLangId == xml || editorLangId == xsl) && config.urdr.oxygenShortcuts" },
      { "command": "urdr.deleteElementTags", "key": "alt+shift+x", "mac": "cmd+alt+x", "when": "editorTextFocus && !editorReadonly && (editorLangId == xml || editorLangId == xsl) && config.urdr.oxygenShortcuts" },
      { "command": "urdr.splitElement", "key": "alt+shift+d", "mac": "ctrl+alt+d", "when": "editorTextFocus && !editorReadonly && (editorLangId == xml || editorLangId == xsl) && config.urdr.oxygenShortcuts" },
      { "command": "urdr.joinElements", "key": "alt+shift+j", "mac": "cmd+alt+j", "when": "editorTextFocus && !editorReadonly && (editorLangId == xml || editorLangId == xsl) && config.urdr.oxygenShortcuts" }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "urdr.preview",
          "when": "resourceLangId == xml || resourceLangId == xsl",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        { "command": "urdr.transform", "when": "resourceLangId == xml || resourceLangId == xsl" },
        { "command": "urdr.preview", "when": "resourceLangId == xml || resourceLangId == xsl" }
      ],
      "explorer/context": [
        { "command": "urdr.compileOdd", "when": "resourceExtname == .odd", "group": "urdr" },
        {
          "command": "urdr.transform",
          "when": "resourceLangId == xml || resourceLangId == xsl",
          "group": "urdr"
        },
        {
          "command": "urdr.preview",
          "when": "resourceLangId == xml || resourceLangId == xsl",
          "group": "urdr"
        }
      ],
      "commandPalette": [
        { "command": "urdr.surroundWithTags", "when": "editorLangId == xml || editorLangId == xsl" },
        { "command": "urdr.surroundWithLastTag", "when": "editorLangId == xml || editorLangId == xsl" },
        { "command": "urdr.deleteElementTags", "when": "editorLangId == xml || editorLangId == xsl" },
        { "command": "urdr.splitElement", "when": "editorLangId == xml || editorLangId == xsl" },
        { "command": "urdr.joinElements", "when": "editorLangId == xml || editorLangId == xsl" },
        { "command": "urdr.renameElement", "when": "editorLangId == xml || editorLangId == xsl" },
        { "command": "urdr.compileOdd", "when": "resourceExtname == .odd" },
        { "command": "urdr.transform", "when": "editorLangId == xml || editorLangId == xsl" },
        { "command": "urdr.preview", "when": "editorLangId == xml || editorLangId == xsl" }
      ]
    }
  },
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "bundle": "node scripts/bundle.mjs",
    "build": "npm run wasm && npm run typecheck && npm run bundle",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.mts",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.95.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  }
}
